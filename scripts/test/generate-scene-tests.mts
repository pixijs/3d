import fs from 'node:fs';
import path from 'node:path';

import type { Plugin } from 'vitest/config';

const MARKER = '// AUTO-GENERATED by scripts/test/generate-scene-tests.mts — do not edit.';

function findFiles(dir: string, suffix: string, out: string[] = []): string[] {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      findFiles(full, suffix, out);
    } else if (entry.name.endsWith(suffix)) {
      out.push(full);
    }
  }

  return out;
}

function wrapperFor(sceneFile: string): string {
  // `cube.scene.ts` -> import `./cube.scene`, snapshot key `cube.scene.ts`.
  const moduleName = path.basename(sceneFile, '.ts');

  return [
    MARKER,
    `import { defineSceneTests } from '@test-utils';`,
    ``,
    `import { scene } from './${moduleName}';`,
    ``,
    `defineSceneTests('${moduleName}.ts', scene);`,
    ``,
  ].join('\n');
}

/**
 * Generates one `*.test.ts` wrapper per `*.scene.ts` so the visual suite gets
 * file-level parallelism (vitest parallelizes files, not tests within a file).
 *
 * Wrappers are gitignored build artifacts kept in sync on every vitest start:
 * missing/stale ones are (re)written and orphaned ones (scene deleted) are
 * pruned. Only files carrying the generator marker are ever removed.
 * @param scenesDir - Directory holding the `*.scene.ts` files
 */
export default function generateSceneTests(scenesDir: string): Plugin {
  const root = path.resolve(scenesDir);
  const wanted = new Set<string>();

  for (const sceneFile of findFiles(root, '.scene.ts')) {
    const wrapper = sceneFile.replace(/\.scene\.ts$/, '.test.ts');

    wanted.add(wrapper);

    const content = wrapperFor(sceneFile);

    if (!fs.existsSync(wrapper) || fs.readFileSync(wrapper, 'utf8') !== content) {
      fs.writeFileSync(wrapper, content);
    }
  }

  for (const wrapper of findFiles(root, '.test.ts')) {
    if (wanted.has(wrapper)) {
      continue;
    }

    if (fs.readFileSync(wrapper, 'utf8').startsWith(MARKER)) {
      fs.unlinkSync(wrapper);
    }
  }

  return { name: 'vitest:generate-scene-tests' };
}
